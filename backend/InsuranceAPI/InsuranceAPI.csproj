    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c602f8c3-dc86-43f9-add8-c160bd9d4582</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
